{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalebBible",
  "version": "0.13.14",
  "identifier": "com.CalebBible.terminal",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh ../scripts/bundle-prep.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "갈렙바이블 — 목회 종합 AI 도구",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/CalebBibled",
      "binaries/CalebBible"
    ],
    "resources": {
      "resources/pack.tar.gz": "./",
      "resources/pack-manifest.json": "./",
      "runtime/": "runtime/",
      "resources/book-assets/": "book-assets/",
      "../ccms/ccms-app.html": "ccms/ccms-app.html"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1Nzc1MUQzQ0E0NTdGRTYKUldUbWYwWEswMUYzWlhXOUkzYzkzT0lsZXlCV1JseU5xTEszSXpPOGY4M05Qb3NadVZUckN6eEEK",
      "endpoints": [
        "https://github.com/dadreampark-rgb/CalebBible/releases/latest/download/latest.json"
      ]
    }
  }
}
